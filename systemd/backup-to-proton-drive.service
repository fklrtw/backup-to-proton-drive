[Unit]
Description=One-shot backup sync to Proton Drive via Compose
After=network-online.target docker.service
Wants=network-online.target
# Uncomment when using Docker Engine; leave commented for rootless Podman:
# Requires=docker.service

[Service]
Type=oneshot
# Adjust WorkingDirectory to the folder containing your compose.yaml
WorkingDirectory=/opt/backup-to-proton-drive

# Optional host-sealed at-rest encryption key using systemd-creds (recommended on systemd >= 250):
#   1. Create encrypted credential on the host (TPM2 / host-key sealed):
#        umask 077
#        openssl rand -base64 32 | systemd-creds encrypt --name=data_encryption_key - /etc/credstore.encrypted/backup-to-proton-drive.key.cred
#   2. Uncomment LoadCredentialEncrypted below.
#   3. With rootless Podman running as this service user, $CREDENTIALS_DIRECTORY/data_encryption_key
#      can be mounted into the container (or passed via `--mount type=bind,src=${CREDENTIALS_DIRECTORY}/data_encryption_key,dst=/run/secrets/data_encryption_key,ro`).
#      With Docker Engine / Docker Compose running the container as UID 1000 (`node`), ensure
#      either the secret file under ./secrets/data_encryption_key.txt or your mounted credential
#      is readable by container UID 1000 (`node`).
# LoadCredentialEncrypted=data_encryption_key:/etc/credstore.encrypted/backup-to-proton-drive.key.cred

# Runs the `backup` service (which uses `profiles: ["backup"]` while `status` runs via `docker compose up -d`).
# For pre-sync hooks with automatic failure telemetry (e.g. Paperless document_exporter), use examples/run-backup.sh instead.
# For Podman, replace docker with /usr/bin/podman.
ExecStart=/usr/bin/docker compose run --rm backup
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
